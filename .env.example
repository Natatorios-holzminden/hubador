# Copiá este archivo como .env (queda gitignoreado) y completá los valores.

# ── API (services/api) ─────────────────────────────────────────────
# Postgres local vía Docker (docker compose up -d db)
DATABASE_URL="postgresql://hubador:hubador@localhost:5432/hubador?schema=public"
# DB separada para los tests e2e (npm run test:e2e) — se crea sola con docker compose
DATABASE_URL_TEST="postgresql://hubador:hubador@localhost:5432/hubador_test?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"

# Auth propia (sin Supabase). Generá un secreto: openssl rand -base64 48
JWT_SECRET="cambiá-esto-por-un-secreto-largo-de-al-menos-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Opcional: crea/actualiza un usuario admin al correr `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Ingesta de precios (services/ingestion) ───────────────────────
COTO_SUCURSAL_ID="12-1-44"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Frontends (apps/*) — se inyectan en build como VITE_* ─────────
VITE_API_URL="http://localhost:3000"
