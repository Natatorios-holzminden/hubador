// Fuente de verdad de la base de datos de Hubador.
// Correr:  npm run db:migrate  (dev)  ·  npm run db:seed  (carga central/data.json)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Source {
  mercado_central
  coto
  jorge
}

enum Category {
  fruta
  verdura
}

enum Unit {
  kg
  atado
  unidad
}

enum GroupStatus {
  formacion
  cerrado
  entregado
  cancelado
}

enum OrderStatus {
  pendiente
  confirmado
  en_preparacion
  en_camino
  entregado
  cancelado
}

/// Usuario de Hubador. Auth propia: email + contraseña (hash scrypt).
model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  nombre       String?
  barrio       String?
  telefono     String?
  direccion    String?
  lat          Float?
  lng          Float?
  role         Role     @default(user)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  groupsCreated Group[]        @relation("GroupCreator")
  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("profiles")
}

/// Refresh tokens con rotación. Se guarda sólo el hash, nunca el token en claro.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nombre    String
  categoria Category
  unidad    Unit     @default(kg)
  variedad  String?
  origen    String?
  imagen    String?
  topRank   Int?     @map("top_rank")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pricePoints PricePoint[]
  groups      Group[]
  orders      Order[]

  @@map("products")
}

/// Serie temporal de precios por fuente. Reemplaza los CSV de central/.
model PricePoint {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  source    Source
  precio    Decimal  @db.Decimal(12, 2)
  moneda    String   @default("ARS")
  scrapedAt DateTime @map("scraped_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, source, scrapedAt])
  @@map("price_points")
}

model Group {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  product        Product     @relation(fields: [productId], references: [id])
  barrio         String
  precioUnitario Decimal     @map("precio_unitario") @db.Decimal(12, 2)
  kgObjetivo     Decimal     @map("kg_objetivo") @db.Decimal(10, 2)
  kgCompletados  Decimal     @default(0) @map("kg_completados") @db.Decimal(10, 2)
  estado         GroupStatus @default(formacion)
  deadline       DateTime
  creadoPor      String      @map("creado_por") @db.Uuid
  creador        Profile     @relation("GroupCreator", fields: [creadoPor], references: [id])
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  orders Order[]

  @@index([barrio, estado])
  @@map("groups")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  user           Profile     @relation(fields: [userId], references: [id])
  groupId        String?     @map("group_id") @db.Uuid
  group          Group?      @relation(fields: [groupId], references: [id])
  productId      String      @map("product_id") @db.Uuid
  product        Product     @relation(fields: [productId], references: [id])
  qtyKg          Decimal     @map("qty_kg") @db.Decimal(10, 2)
  precioUnitario Decimal     @map("precio_unitario") @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(14, 2)
  estado         OrderStatus @default(pendiente)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  events OrderEvent[]

  @@index([userId])
  @@map("orders")
}

/// Historial de estados de un pedido — alimenta la timeline de "seguimiento".
model OrderEvent {
  id      String      @id @default(uuid()) @db.Uuid
  orderId String      @map("order_id") @db.Uuid
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  estado  OrderStatus
  at      DateTime    @default(now())

  @@index([orderId])
  @@map("order_events")
}

model TelegramSub {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @unique @map("chat_id")
  userId    String?  @map("user_id") @db.Uuid
  filtros   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_subs")
}
